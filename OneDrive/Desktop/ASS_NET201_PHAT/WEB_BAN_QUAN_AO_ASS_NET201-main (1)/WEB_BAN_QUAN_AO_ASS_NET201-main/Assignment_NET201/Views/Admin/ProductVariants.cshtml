@model IEnumerable<Assignment_NET201.Models.ProductVariant>
@{
    var product = ViewBag.Product as Assignment_NET201.Models.Product;
    ViewData["Title"] = $"Variants for {product?.Name}";
    Layout = "_AdminLayout";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Inventory">Inventory</a></li>
        <li class="breadcrumb-item active">@product?.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">@product?.Name - Variants</h3>
    <a asp-action="CreateVariant" asp-route-productId="@product?.Id" class="btn btn-dark">
        <i class="fas fa-plus me-2"></i>Add Variant
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row">
    @foreach (var variant in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-0">@variant.Size / @variant.Color</h5>
                            <small class="text-muted">Stock: <span
                                    class="fw-bold text-dark">@variant.Quantity</span></small>
                        </div>
                        @if (variant.PriceOverride.HasValue)
                        {
                            <span class="badge bg-warning text-dark">@variant.PriceOverride.Value.ToString("N0") VND</span>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success flex-grow-1" data-bs-toggle="modal"
                            data-bs-target="#importModal-@variant.Id">
                            <i class="fas fa-plus-circle me-1"></i> Import
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger flex-grow-1" data-bs-toggle="modal"
                            data-bs-target="#exportModal-@variant.Id">
                            <i class="fas fa-minus-circle me-1"></i> Export
                        </button>
                    </div>
                </div>
            </div>

            <!-- Import Modal -->
            <div class="modal fade" id="importModal-@variant.Id" tabindex="-1">
                <div class="modal-dialog">
                    <form asp-action="ImportStock" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="variantId" value="@variant.Id" />
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Import Stock - @variant.Size / @variant.Color</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Quantity to Add</label>
                                    <input type="number" name="quantity" class="form-control" min="1" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Note</label>
                                    <textarea name="note" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-success">Import</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Export Modal -->
            <div class="modal fade" id="exportModal-@variant.Id" tabindex="-1">
                <div class="modal-dialog">
                    <form asp-action="ExportStock" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="variantId" value="@variant.Id" />
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">Export Stock - @variant.Size / @variant.Color</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label class="form-label">Quantity to Remove</label>
                                    <input type="number" name="quantity" class="form-control" min="1"
                                        max="@variant.Quantity" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Note</label>
                                    <textarea name="note" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger">Export</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
